# Gradle
.gradle/
build/
out/
bin/

# Repository-local JDK and Gradle user home
/.local-tools/

# Local game/runtime data
run/
logs/
crash-reports/

# IDE settings
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Local AI agent instructions
/AGENTS.md
/.agents/

# Java and diagnostic output
*.class
*.log
hs_err_pid*
replay_pid*

# Locally supplied dependencies
lib/

# Packaged artifacts created in the project root
/*.jar
/*.zip

# Source audio retained locally; converted OGG assets are tracked under resources
/*.wav

# Operating-system metadata
.DS_Store
Thumbs.db

# Generated from the development environment's Minecraft resources by
# tools/terrain/make_noise_settings.py. Holds vanilla surface rules verbatim, so
# it is regenerated rather than committed.
/src/main/resources/data/minecraft/worldgen/noise_settings/overworld.json

# Python bytecode from the terrain tooling
__pycache__/
*.pyc

# World saves captured from the live server for analysis
/archive-*.tar.gz
